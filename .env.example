# Netlify Database connection string (auto-injected on Netlify as NETLIFY_DB_URL)
NETLIFY_DB_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Public site URL (used by NextAuth for callbacks)
NEXTAUTH_URL="https://qingtian-pay.netlify.app"

# Resend email
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"

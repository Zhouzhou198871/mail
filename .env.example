# Netlify Database (automatically injected by Netlify Database)
NETLIFY_DB_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth - keep these values in Netlify Secret environment variables
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="https://mail.lynli.me"

# First-run password for the three built-in administrators.
# At least 24 characters. Applied once; subsequent password changes persist.
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-unique-32-character-password"

# AES-256-GCM key for encrypting sender-provider credentials at rest.
# Exactly 64 hexadecimal characters.
PROVIDER_ENCRYPTION_KEY="replace-with-64-hex-characters"

# Resend - use a verified sender domain for production delivery
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="no-reply@your-verified-domain.example"

# Optional DNS integrations (store tokens as Netlify secrets)
CF_API_TOKEN=""
CF_ACCOUNT_ID=""
DNSHE_API_ID=""
DNSHE_API_TOKEN=""

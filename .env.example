# Prisma schema generation only. Runtime database access uses the Cloudflare D1 binding.
DATABASE_URL="file:./dev.db"

# Local OpenNext development values. Production secrets belong in Cloudflare Workers > Settings > Variables and Secrets.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="https://mail.lynli.me"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-unique-32-character-password"

# Self-hosted mail delivery endpoint. Keep the API key secret; never commit a real value.
VPS_MAIL_API_URL="https://mail-api.your-domain.example/send"
VPS_MAIL_API_KEY="replace-with-a-long-random-secret"
VPS_MAIL_FROM_EMAIL="MailHub <no-reply@lynli.me>"
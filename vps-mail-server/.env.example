# Must exactly match Cloudflare Secret VPS_MAIL_API_KEY.
VPS_MAIL_API_KEY="replace-with-a-long-random-secret"

# Local SMTP daemon. This service only connects to loopback port 25.
SMTP_HOST="127.0.0.1"
SMTP_PORT="25"
SMTP_FROM="MailHub <no-reply@lynli.me>"

# Persistent idempotency database.
IDEMPOTENCY_DB="./mail-idempotency.sqlite"
PORT="8787"
HOST="127.0.0.1"
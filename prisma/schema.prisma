generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Normalized at build time by scripts/resolve-db-url.mjs from
  // NETLIFY_DB_URL | NETLIFY_DATABASE_URL | DATABASE_URL
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
